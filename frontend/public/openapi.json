{
  "openapi": "3.0.3",
  "info": {
    "title": "BioPharma Radar",
    "version": "1.0.0",
    "description": "Static GET. Download then filter. Unix-second timestamps; partial coverage."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/data/latest.json": {
      "get": {
        "operationId": "latest_json",
        "summary": "All news with source health",
        "responses": {
          "200": {
            "description": "Static JSON snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          }
        }
      }
    },
    "/data/briefing.json": {
      "get": {
        "operationId": "briefing_json",
        "summary": "Cached AI briefing",
        "responses": {
          "200": {
            "description": "Static JSON snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Briefing"
                }
              }
            }
          }
        }
      }
    },
    "/data/markets/a.json": {
      "get": {
        "operationId": "markets_a_json",
        "summary": "A shares",
        "responses": {
          "200": {
            "description": "Static JSON snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "market": {
                      "type": "string"
                    },
                    "updated_at": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/News"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/markets/hk.json": {
      "get": {
        "operationId": "markets_hk_json",
        "summary": "Hong Kong",
        "responses": {
          "200": {
            "description": "Static JSON snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "market": {
                      "type": "string"
                    },
                    "updated_at": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/News"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/markets/us.json": {
      "get": {
        "operationId": "markets_us_json",
        "summary": "US",
        "responses": {
          "200": {
            "description": "Static JSON snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "market": {
                      "type": "string"
                    },
                    "updated_at": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/News"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/markets/global.json": {
      "get": {
        "operationId": "markets_global_json",
        "summary": "Global",
        "responses": {
          "200": {
            "description": "Static JSON snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "market": {
                      "type": "string"
                    },
                    "updated_at": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/News"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "News": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "source",
          "source_id",
          "markets",
          "published_at",
          "first_seen_at",
          "excerpt"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "markets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "A",
                "HK",
                "US",
                "GLOBAL"
              ]
            }
          },
          "companies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "published_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix seconds; null means source publication time is unknown."
          },
          "first_seen_at": {
            "type": "integer",
            "description": "Unix seconds of first collection, not publication."
          },
          "excerpt": {
            "type": "string"
          }
        }
      },
      "Briefing": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "generated_at": {
            "type": "integer",
            "nullable": true
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "schema_version",
          "updated_at",
          "collection_status",
          "items"
        ],
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "updated_at": {
            "type": "integer"
          },
          "last_success_at": {
            "type": "integer",
            "nullable": true
          },
          "collection_status": {
            "type": "string",
            "enum": [
              "ok",
              "partial",
              "failed"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/News"
            }
          },
          "briefing": {
            "$ref": "#/components/schemas/Briefing"
          }
        }
      }
    }
  }
}
